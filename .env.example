NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=
REDIS_URL=

JWT_ADMIN_ACCESS_SECRET=
JWT_CUSTOMER_ACCESS_SECRET=
JWT_ADMIN_ACCESS_TTL=15m
JWT_CUSTOMER_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

IDEMPOTENCY_TTL_SECONDS=86400

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
LOCAL_UPLOAD_DIR=uploads
IMAGE_OPTIMIZATION_ENABLED=false
INVENTORY_MANAGEMENT_ENABLED=false
RAPID_PRODUCT_INTAKE_ENABLED=false
IMAGE_MAX_PIXELS=12000000
IMAGE_OPTIMIZATION_CONCURRENCY=1
PUBLIC_BASE_URL=

# Native push is explicitly disabled until real Firebase credentials are mounted.
PUSH_PROVIDER=disabled
FIREBASE_SERVICE_ACCOUNT_HOST_FILE=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_PROJECT_ID=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aboessa-media

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
