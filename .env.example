NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_commerce?schema=public
REDIS_URL=redis://localhost:6379

JWT_ADMIN_ACCESS_SECRET=replace-with-a-long-random-admin-access-secret
JWT_CUSTOMER_ACCESS_SECRET=replace-with-a-long-random-customer-access-secret
JWT_SCREEN_ACCESS_SECRET=replace-with-a-long-random-screen-access-secret
JWT_ADMIN_ACCESS_TTL=15m
JWT_CUSTOMER_ACCESS_TTL=15m
JWT_SCREEN_ACCESS_TTL=30m
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://192.168.1.5:8080
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
IDEMPOTENCY_TTL_SECONDS=86400

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
LOCAL_UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8080

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=live-commerce-dev

SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-in-env
SEED_ADMIN_NAME=Store Owner
