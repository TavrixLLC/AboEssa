# Copy this file to an operator-owned location outside the repository.
# Empty values below are deliberate: production values must be owner supplied.
NODE_ENV=production
INVENTORY_MANAGEMENT_ENABLED=false
RAPID_PRODUCT_INTAKE_ENABLED=false
# Stage A: browser/review is not permission to dispatch paid image transfers.
PRODUCT_STUDIO_DISPATCH_ENABLED=false
PRODUCT_STUDIO_PROVIDER=fal
PRODUCT_STUDIO_ENABLED=false
PRODUCT_STUDIO_LIVE_APPROVED=false
PRODUCT_STUDIO_MOCK_APPROVED=false
REAL_PRODUCT_STUDIO_REVIEW_ENABLED=false
PRODUCT_STUDIO_PREPAID_EXPERIMENT=false
AI_LIVE_CALLS_APPROVED=false
IMAGE_AI_LIVE_APPROVED=false
# Provider secrets and QA sample/index paths must not be placed in this example.
PORT=3000
API_PREFIX=api

JWT_ADMIN_ACCESS_SECRET=
JWT_CUSTOMER_ACCESS_SECRET=
JWT_ADMIN_ACCESS_TTL=15m
JWT_CUSTOMER_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

PUBLIC_BASE_URL=
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
IDEMPOTENCY_TTL_SECONDS=86400

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
LOCAL_UPLOAD_DIR=uploads
IMAGE_OPTIMIZATION_ENABLED=false
IMAGE_MAX_PIXELS=12000000
IMAGE_OPTIMIZATION_CONCURRENCY=1
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=aboessa-media

PUSH_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/aboessa-firebase-admin.json
FIREBASE_PROJECT_ID=aboessa-cf3e7

# DATABASE_URL and REDIS_URL are assembled inside the API container from
# external Docker secret files; never place those passwords here.
